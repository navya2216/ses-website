DROP DATABASE IF EXISTS career_portal;

CREATE DATABASE career_portal;

USE career_portal;

CREATE TABLE super_admin (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
ALTER TABLE super_admin
ADD COLUMN password VARCHAR(255) NOT NULL AFTER email;
DROP TABLE IF EXISTS super_admin;

CREATE TABLE admins (
    id INT AUTO_INCREMENT PRIMARY KEY,

    super_admin_id INT NOT NULL,

    name VARCHAR(100) NOT NULL,

    email VARCHAR(255) UNIQUE NOT NULL,

    password VARCHAR(255) NOT NULL,

    phone VARCHAR(20),

    status ENUM('Active','Inactive') DEFAULT 'Active',

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (super_admin_id)
    REFERENCES super_admin(id)
    ON DELETE CASCADE
);

CREATE TABLE career_jobs (
    id INT AUTO_INCREMENT PRIMARY KEY,
    target_email VARCHAR(255) NOT NULL,
    job_role VARCHAR(255) NOT NULL,
    location VARCHAR(100) NOT NULL,
    job_type VARCHAR(100) NOT NULL,
    description TEXT NOT NULL,
    vacancies INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);



CREATE TABLE applications (
    id INT AUTO_INCREMENT PRIMARY KEY,

    job_id INT NULL,

    selected_roles TEXT NOT NULL,

    applicant_name VARCHAR(255) NOT NULL,

    applicant_email VARCHAR(255) NOT NULL UNIQUE,

    applicant_phone VARCHAR(20) NOT NULL UNIQUE,

    experience_type ENUM('Fresher','Experienced') NOT NULL,

    current_salary DECIMAL(10,2) DEFAULT NULL,

    expected_salary DECIMAL(10,2) NOT NULL,

    resume_path VARCHAR(500) NULL,

    status ENUM('Pending','Shortlisted','Rejected')
        DEFAULT 'Pending',

    applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_job
        FOREIGN KEY (job_id)
        REFERENCES career_jobs(id)
        ON DELETE SET NULL
);




